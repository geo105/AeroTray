Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: dsm_world
    Background Color: 35; 40; 50
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Suelo
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/MarkerArray
      Name: Octocoptero y sensores
      Enabled: true
      Topic:
        Value: /dsm_sim/modelo
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
    - Class: rviz_default_plugins/TF
      Name: Ejes
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.08
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.1
      Focal Point: {X: 0, Y: 0, Z: 0.5}
      Pitch: 0.35
      Yaw: 0.8
      Target Frame: dsm_world
Window Geometry:
  Width: 1280
  Height: 850
